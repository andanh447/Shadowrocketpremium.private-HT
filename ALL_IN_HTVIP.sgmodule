[Rule]
# ==========================================
# SUPER FIREWALL ĐHT - PHÒNG THỦ TUYỆT ĐỐI
# ==========================================

# 1. ĐÓNG SẬP CÁC CỔNG NGUY HIỂM (Chống quét port, ngăn chặn xâm nhập từ xa)
AND,((PROTOCOL,TCP),(DEST-PORT,445)),REJECT
AND,((PROTOCOL,TCP),(DEST-PORT,3389)),REJECT
AND,((PROTOCOL,TCP),(DEST-PORT,23)),REJECT
AND,((PROTOCOL,TCP),(DEST-PORT,21)),REJECT
AND,((PROTOCOL,TCP),(DEST-PORT,22)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,1900)),REJECT

# 2. CHẶN DẢI IP RÁC & CHỐNG GIẢ MẠO IP (Ngăn các cuộc tấn công ẩn danh)
IP-CIDR,0.0.0.0/8,REJECT,no-resolve
IP-CIDR,100.64.0.0/10,REJECT,no-resolve
IP-CIDR,169.254.0.0/16,REJECT,no-resolve
