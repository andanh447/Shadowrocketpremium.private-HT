# 🌟 PHẦN LÕI XỬ LÝ DỮ LIỆU (SCRIPT CORE) 🌟
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Script]
# Tiêm mã VIP vào API RevenueCat - Đã tối ưu tốc độ
Locket_Gold_Core = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/.*),requires-body=1,max-size=524288,timeout=60,script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/locketgoldHT.js


[MITM]
hostname = %APPEND%, api.revenuecat.com
